rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is authorized
    // For production, implement proper role-based access control
    function isAuthorized() {
      return request.auth != null;
    }

    // Patients collection - contains PHI/sensitive medical data
    match /patients/{patientId} {
      // For production: Require authentication
      // Currently allowing read/write for development
      // IMPORTANT: Change this before production deployment!
      allow read, write: if true;

      // Production-ready rule (uncomment when authentication is implemented):
      // allow read, write: if isAuthorized();

      // Validate patient data structure
      allow create: if request.resource.data.keys().hasAll([
        'name', 'id', 'doa', 'age', 'bed', 'sex',
        'weight', 'ward', 'timestamp'
      ]);

      // Ensure ward is valid
      allow update: if request.resource.data.ward in [
        'PW', 'GW', 'SW', 'PVT', 'ICU', 'NICU', 'ER', 'Discharge'
      ];
    }

    // Meta collection for notes and shared data
    match /meta/{document} {
      // For production: Require authentication
      allow read, write: if true;

      // Production-ready rule:
      // allow read, write: if isAuthorized();
    }

    // Summaries collection for admission/discharge statistics
    match /summaries/{document} {
      // For production: Require authentication
      allow read, write: if true;

      // Production-ready rule:
      // allow read, write: if isAuthorized();
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
