    function logPlan(id) {
      console.log(`Attempting to log plan for patient ${id}`);
      const planEl = document.querySelector(`#plan-content-${id}`);
      const currentPlan = planEl ? planEl.innerText.trim() : '';
      if (currentPlan === '') {
        console.log('Plan is empty, not logging');
        return;
      }
      db.collection('patients').doc(id).get().then(doc => {
        if (doc.exists) {
          const doa = doc.data().doa;
          const daysAdmitted = calculateDaysAdmitted(doa);
          const timestamp = Date.now();
          const formattedTimestamp = formatTimestamp(timestamp);
          const fullLogEntry = `• ${formattedTimestamp} (${daysAdmitted})\n  ${currentPlan}\n\n`;

          const lastLoggedPlan = (doc.data().lastLoggedPlan || '').trim();
          const currentLines = currentPlan.split('\n').map(line => line.trim()).filter(line => line !== '');
          const lastLines = lastLoggedPlan.split('\n').map(line => line.trim()).filter(line => line !== '');
          
          let commonPrefixLength = 0;
          while (commonPrefixLength < lastLines.length && 
                 commonPrefixLength < currentLines.length && 
                 lastLines[commonPrefixLength] === currentLines[commonPrefixLength]) {
            commonPrefixLength++;
          }
          
          let newLogEntry = fullLogEntry;
          const newLines = currentLines.slice(commonPrefixLength).join('\n  ');
          if (newLines) {
            newLogEntry = `• ${formattedTimestamp} (${daysAdmitted})\n  ${newLines}\n\n`;
          }
          
          if (!newLines && currentPlan === lastLoggedPlan) {
            console.log('No new content to log');
            return;
          }
          
          const currentLogs = doc.data().logs || '';
          const updatedLogs = currentLogs + newLogEntry;
          
          db.collection('patients').doc(id).update({
            logs: updatedLogs,
            lastLoggedPlan: currentPlan
          }).then(() => {
            console.log('Plan logged successfully for patient', id);
            console.log(`Updated lastLoggedPlan to: "${currentPlan}"`);
            const logBtn = document.querySelector(`.log-btn[onclick="logPlan('${id}')"]`);
            if (logBtn) {
              logBtn.disabled = true;
              logBtn.innerText = 'Logged';
            }
          }).catch(error => {
            console.error('Error logging plan:', error);
            const logBtn = document.querySelector(`.log-btn[onclick="logPlan('${id}')"]`);
            if (logBtn) {
              logBtn.disabled = true;
              logBtn.innerText = 'Logged';
            }
          });
        }
      });
    }
