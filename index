        }
        sec.appendChild(header);
        const grid = document.createElement('div');
        grid.className = 'card-grid';
        grid.id = `ward-${w}`;
        if (w !== 'Discharge') {
          grid.classList.add('expanded');
        }
        sec.appendChild(grid);
        container.appendChild(sec);
        wardGrids[w] = grid;
      });

      db.collection('patients').onSnapshot(snap => {
        const wardCounts = {};
        const patientsByWard = {};
        wards.forEach(w => {
          wardCounts[w] = 0;
          patientsByWard[w] = [];
        });
        let totalActive = 0;
        const oneWeekMs = 7 * 24 * 60 * 60 * 1000;
        const now = Date.now();

        Object.keys(patientCards).forEach(id => {
          if (patientCards[id]) {
            patientCards[id].remove();
          }
        });
        patientCards = {};

        snap.forEach(doc => {
          const d = doc.data();
          const id = doc.id;
          const ward = d.ward;

          if (!wards.includes(ward)) {
            console.warn(`Invalid ward for patient ${id}: ${ward}`);
            return;
          }

          if (ward === 'Discharge' && (d.dischargeTimestamp || d.timestamp || now) < now - oneWeekMs) {
            console.log(`Deleting patient ${id} from Discharges: dischargeTimestamp=${d.dischargeTimestamp} is over a week old`);
            db.collection('patients').doc(id).delete().catch(error => {
              console.error(`Error deleting patient ${id}:`, error);
            });
            return;
          }

          patientsByWard[ward].push({ id, data: d });
          wardCounts[ward]++;
          if (ward !== 'Discharge') totalActive++;
        });

        document.getElementById('totalCount').innerText = totalActive;

        wards.forEach(w => {
          if (w === 'Discharge') {
            patientsByWard[w].sort((a, b) => {
              const timeA = a.data.dischargeTimestamp || a.data.timestamp || 0;
              const timeB = b.data.dischargeTimestamp || b.data.timestamp || 0;
              return timeB - timeA;
            });
          } else {
            patientsByWard[w].sort((a, b) => {
              const bedA = parseInt(a.data.bed) || 0;
              const bedB = parseInt(b.data.bed) || 0;
              return bedA - bedB;
            });
          }

          wardGrids[w].innerHTML = '';

          patientsByWard[w].forEach(({ id, data: d }) => {
            console.log(`Rendering patient ${id}: ward=${d.ward}, dischargeTimestamp=${d.dischargeTimestamp}`);
            const daysAdmitted = calculateDaysAdmitted(d.doa);
            let computedAge = d.age;
            if (d.isAutoAge && d.dob && d.dot) {
              computedAge = calculateNeonatalAge(d.dob, d.dot).display;
              if (computedAge !== d.age) {
                db.collection('patients').doc(id).update({ age: computedAge });
              }
            }
            const makeEditable = (field, label = '') =>
              `<p><strong>${label}</strong><span contenteditable class="editable" onblur="updateField('${id}', '${field}', this.innerText)">${d[field] || ''}</span></p>`;
            const logs = d.logs || 'No logs yet';
            let dischargeTag = '';
            if (d.ward === 'Discharge') {
              const timestamp = d.dischargeTimestamp || d.timestamp || Date.now();
              const formatted = formatTimestamp(timestamp);
              dischargeTag = `<span class="discharge-badge discharge-active" data-id="${id}">Discharged on ${formatted}</span>`;
              console.log(`Adding discharge badge for patient ${id}: Discharged on ${formatted}`);
            }
            const currentPlan = (d.plan || '').trim();
            const lastLoggedPlan = (d.lastLoggedPlan || '').trim();
            const needsLog = currentPlan !== '' && currentPlan !== lastLoggedPlan;
            console.log(`Patient ${id}: needsLog=${needsLog}, currentPlan="${currentPlan}", lastLoggedPlan="${lastLoggedPlan}"`);
            const card = document.createElement('div');
            card.className = 'patient-card';
            card.innerHTML = `
              <button class="delete-btn" onclick="deletePatient('${id}')">×</button>
              <span class="new-badge${d.isNew ? ' new-active' : ''}" data-id="${id}">NEW</span>
              ${dischargeTag}
              <p><strong>Name:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'name', this.innerText)">${d.name}</span></p>
              <p><strong>ID:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'id', this.innerText)">${d.id || ''}</span></p>
              <p><strong>DOA:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'doa', this.innerText)">${d.doa || ''}</span> <span id="doa-days-${id}">(${daysAdmitted})</span></p>
              <p><strong>Shift:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'shift', this.innerText)">${d.shift || ''}</span></p>
              <p><strong>Bed:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'bed', this.innerText)">${d.bed || ''}</span></p>
              <p><strong onclick="toggleAgeMode('${id}')">Age:</strong> <span id="age-display-${id}" contenteditable="${!d.isAutoAge}" onblur="updateField('${id}', 'age', this.innerText)">${computedAge}</span></p>
              <div class="age-toggle" id="age-toggle-${id}">
                <label><input type="radio" name="ageMode-${id}" value="manual" ${!d.isAutoAge ? 'checked' : ''} onchange="toggleAutoInputs('${id}')"> Manual</label>
                <label><input type="radio" name="ageMode-${id}" value="auto" ${d.isAutoAge ? 'checked' : ''} onchange="toggleAutoInputs('${id}'); saveAgeMode('${id}')"> Auto (HOL/DOL)</label>
                <div class="auto-age-inputs" id="auto-age-inputs-${id}" style="display: ${d.isAutoAge ? 'flex' : 'none'}">
                  <input type="date" id="dob-${id}" value="${d.dob || ''}" onblur="saveAgeMode('${id}')">
                  <input type="time" id="dot-${id}" value="${d.dot || ''}" onblur="saveAgeMode('${id}')">
                </div>
              </div>
              <p class="inline-fields">
                <strong>Sex:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'sex', this.innerText)">${d.sex || ''}</span>
              </p>
              <p><strong>Weight:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'weight', this.innerText)">${d.weight || ''}</span></p>
              <p><strong>Diagnosis:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'diagnosis', this.innerText)">${d.diagnosis || ''}</span></p>
              <p><strong>Medications:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'medications', this.innerText)">${d.medications || ''}</span></p>
              <p><strong>Issues:</strong> <span contenteditable class="editable" onblur="updateField('${id}', 'issues', this.innerText)">${d.issues || ''}</span></p>
              <p><strong class="hopi-toggle" id="hopi-toggle-${id}" onclick="toggleHopi('${id}')" aria-expanded="false">HOPI: ►</strong></p>
              <div class="hopi-content" id="hopi-content-${id}">
                <span contenteditable class="editable" onblur="updateField('${id}', 'hopi', this.innerText)">${d.hopi || ''}</span>
              </div>
              <p><strong class="hopi-toggle" id="plan-toggle-${id}" onclick="togglePlan('${id}')" aria-expanded="false">Plan: ►</strong></p>
              <div class="hopi-content plan-history" id="plan-history-${id}">
                <div contenteditable class="editable" onblur="updateLog('${id}', this.innerText)">${logs}</div>
              </div>
              <p><span contenteditable class="editable" id="plan-content-${id}" onblur="updateField('${id}', 'plan', this.innerText)">${d.plan || ''}</span></p>
              <button class="log-btn" onclick="logPlan('${id}')" ${needsLog ? '' : 'disabled'}>${needsLog ? 'Log' : 'Logged'}</button>
              <p><strong>Ward:</strong>
                <select onchange="changeWard('${id}', this.value)">
                  ${wards.map(wr => `<option value="${wr}" ${wr === d.ward ? 'selected' : ''}>${wr}</option>`).join('')}
                </select>
              </p>
              <p class="new-checkbox">
                <label><input type="checkbox" ${d.isNew ? 'checked' : ''} onchange="toggleNewTag('${id}')"> New</label>
              </p>
            `;
            wardGrids[w].appendChild(card);
            patientCards[id] = card;
            if (d.ward === 'Discharge') {
              const badge = card.querySelector('.discharge-badge');
              if (badge) {
                console.log(`Discharge badge found for patient ${id}, classes: ${badge.className}`);
              } else {
                console.error(`Discharge badge not found for patient ${id}`);
              }
            }
          });

          const header = document.getElementById(`header-${w}`);
          if (header) {
            header.innerText = `${w === 'Discharge' ? 'Discharges' : w} (${wardCounts[w]} patient${wardCounts[w] !== 1 ? 's' : ''})`;
          }
        });

        const breakdownOrder = ["PW", "GW", "SW", "PVT", "ICU", "NICU", "ER"];
        const breakdownText = breakdownOrder.map(w => `${w} (${wardCounts[w] || 0})`).join(', ');
        const breakdownEl = document.getElementById('wardBreakdown');
        if (breakdownEl) breakdownEl.innerText = breakdownText;
      }, error => {
        console.error('Error loading patients:', error);
      });
    }
    loadTheme();
    restoreSummary();
    loadPatients();
  </script>
</body>
</html>
